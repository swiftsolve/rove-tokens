{
  "description": "What Figma variables can't hold. `figma` sets how a Figma variable is written in CSS; `tokens` adds code-only tokens. `{figma/name}` pulls a Figma variable's raw value in for each theme.",
  "figma": {
    "font-family/sans": "'{font-family/sans}', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "font-family/numeric": "'{font-family/numeric}', ui-sans-serif, system-ui, sans-serif"
  },
  "tokens": {
    "--shadow-panel": "0 1px 2px {shadow-color/panel-1}, 0 4px 12px {shadow-color/panel-2}",
    "--shadow-raised": "0 12px 32px {shadow-color/raised}",
    "--shadow-popover": "0 2px 6px {shadow-color/popover-1}, 0 6px 16px {shadow-color/popover-2}",

    "--focus-outline": "var(--focus-ring-width) solid var(--focus-ring)",
    "--focus-inset": "calc(-1 * var(--focus-ring-width))",

    "--ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "--ease-in-out": "cubic-bezier(0.4, 0, 0.2, 1)",
    "--ease-pulse": "cubic-bezier(0.42, 0, 0.58, 1)"
  }
}
