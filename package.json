{
  "name": "@swiftsolve/rove-tokens",
  "version": "4.5.0",
  "description": "Rove's design tokens, exported from the Rove Design System in Figma, as CSS and DTCG.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swiftsolve/rove-tokens.git"
  },
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./text-styles.css": "./dist/text-styles.css",
    "./tailwind-theme.css": "./dist/tailwind-theme.css",
    "./tokens/*": "./dist/tokens/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "DESIGN.md"
  ],
  "scripts": {
    "build": "node scripts/tokens/build.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check": "npm run build && npm run lint && node scripts/checks/contrast.mjs && node scripts/checks/design-md-format.mjs && npm test",
    "test": "node --test figma-plugin/code.test.mjs",
    "figma:export": "node scripts/figma/use-figma.mjs export",
    "figma:save": "node scripts/figma/use-figma.mjs save",
    "figma:check": "node scripts/figma/use-figma.mjs check",
    "prepare": "git config core.hooksPath scripts/hooks/git || true; npm run build",
    "storybook": "storybook dev -p 6007",
    "build:storybook": "storybook build"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/design.md": "^0.4.0",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.6.5",
    "style-dictionary": "^5.7.1",
    "vite": "^7.3.7"
  }
}
